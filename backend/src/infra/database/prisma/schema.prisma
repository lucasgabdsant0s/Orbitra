generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditEntityType {
  PROJECT
  TASK
  COMMENT
}

enum NotificationType {
  COMMENT
  INVITE
  TASK_ASSIGN
  DEADLINE
  PROJECT_UPDATE
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  avatarUrl    String?   @db.MediumText
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdProjects    Project[]           @relation("ProjectCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  refreshTokens      RefreshToken[]
  comments           Comment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  projectMemberships ProjectMember[]
  emailVerifications EmailVerification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  projects       Project[]
  tasks          Task[]
  invites        Invite[]
  comments       Comment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  projectMembers ProjectMember[]

  @@map("tenants")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  tasks    Task[]
  comments Comment[]
  members  ProjectMember[]

  @@index([tenantId])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid())
  tenantId    String
  projectId   String
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User    @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, projectId, status])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(uuid())
  tenantId  String
  projectId String
  userId    String
  parentId  String?
  text      String    @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([tenantId])
  @@index([projectId])
  @@index([parentId])
  @@map("comments")
}

model Invite {
  id        String       @id @default(uuid())
  tenantId  String
  email     String
  role      Role         @default(MEMBER)
  token     String       @unique @db.VarChar(512)
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("invites")
}

model ProjectMember {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  projectId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([tenantId])
  @@map("project_members")
}

model AuditLog {
  id         String          @id @default(uuid())
  tenantId   String
  projectId  String?
  userId     String
  entityType AuditEntityType
  entityId   String
  action     AuditAction
  changes    Json
  timestamp  DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}
