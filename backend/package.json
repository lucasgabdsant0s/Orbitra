{
  "name": "orbitrav2",
  "version": "1.0.0",
  "type": "module",
  "description": "A scalable multi-tenant project management platform that helps teams organize, track, and deliver projects efficiently, built with a clean and maintainable architecture.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate --schema=./src/infra/database/prisma/schema.prisma && tsc && cpy \"src/infra/database/generated/**\" \"dist/infra/database/generated/\"",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:integration": "docker compose -f ../docker-compose.test.yml up -d && wait-on tcp:localhost:3307 --timeout 60000 && dotenv -e .env.test -- npx prisma db push --force-reset --accept-data-loss && dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:down": "docker compose -f ../docker-compose.test.yml down -v",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "postinstall": "prisma generate --schema=./src/infra/database/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@otp-lib/authenticator": "^0.2.1",
    "@prisma/adapter-mariadb": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@scalar/fastify-api-reference": "^1.43.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.3.0",
    "pino-pretty": "^11.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "cpy-cli": "^7.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
